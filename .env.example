# Production secrets: use your cloud secret manager in real deployment.
POSTGRES_DB=cin
POSTGRES_USER=cin
POSTGRES_PASSWORD=replace-with-a-long-random-secret

NEO4J_PASSWORD=replace-with-a-long-random-secret
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g

REDIS_PASSWORD=replace-with-a-long-random-secret

# Public browser-facing API endpoint.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://app.example.com

APP_ENVIRONMENT=production
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000

# Confidence policy thresholds (policy values, not probabilities).
CONFIDENCE_COMBINED_SUPPORT_CAP=0.90
CONFIDENCE_HIGH_MIN_GROUP_SCORE=0.70
CONFIDENCE_HIGH_SCORE_THRESHOLD=0.85
CONFIDENCE_HIGH_MIN_INDEPENDENT_GROUPS=2

# Authentication values are SHA-256 hashes; raw demo credentials belong only in local seed/dev environments.
CIN_AUTH_API_KEYS=submitter:submitter:b4058c303d0e54215e61317ccf704cb288a436181fd70c565051499c202d7837,reviewer:reviewer:32dc90f8d497d0e9c2feb824612a5bd35883a01ba25a4555e173b3a31909a2f2,steward:steward:0e9643da89a77a583192ca3a7fc1434c5861ba745a260605c72fd9c7d1f362f1
CIN_DEMO_STEWARD_API_KEY=demo-steward-key
OUTBOX_RECONCILE_INTERVAL_SECONDS=30
PROCESSING_TIMEOUT_SECONDS=900
CONFIDENCE_HIGH_GATE_EPSILON=0.000001
